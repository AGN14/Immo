# Supabase — Project Settings → API
# Copier ce fichier vers .env.local (ignoré par git) et renseigner les valeurs.

# URL du projet, ex. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique. Sûre côté navigateur : elle est soumise à RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service. CONTOURNE RLS — serveur uniquement, jamais dans un composant
# client, jamais commitée. Si elle fuite, régénérez-la depuis le dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# GeniusPay — https://geniuspay.ci/dashboard/settings?tab=api
# Serveur uniquement : aucun widget, le navigateur ne voit que l'URL de
# checkout. Ils servent à créer le paiement puis à vérifier qu'une
# transaction a réellement été encaissée. Le retour du navigateur ne prouve
# rien — il peut être forgé par n'importe qui.
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=

# « true » en bac à sable, « false » en production. Ne fait que refléter le
# choix dans l'interface : ce sont les préfixes des clés qui tranchent
# (sk_sandbox_… / pk_live_…).
GENIUSPAY_SANDBOX=true

# Admin — e-mails autorisés sur /admin, séparés par des virgules.
# Ex. ADMIN_EMAILS=fondateur@xwegan.com,associe@xwegan.com
# Vide = personne n'entre (redirigé vers /dashboard).
ADMIN_EMAILS=

# Admin — seul hôte sur lequel /admin et /api/admin/* existent.
# Partout ailleurs (dont le domaine public), ces chemins répondent 404.
# Vide = aucune restriction (pratique avant la mise en route du sous-domaine).
# En local (localhost, 127.0.0.1, réseau 192.168.x.x / 10.x.x.x), l'accès reste
# toujours ouvert : cette variable ne casse jamais le développement.
ADMIN_HOST=tower-admin-xwegan.xwegan.dev-teams.tech
